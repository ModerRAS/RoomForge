<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AudioOptimizer.Visualization</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one project reference is Core, which this layer cannot avoid: the level reference's label is built
         from the microphone calibration payload, and IO parses that same payload, so its home must be at or below
         both. Still no packages and no WPF assembly; the layering proof test asserts that. -->
    <ProjectReference Include="..\AudioOptimizer.Core\AudioOptimizer.Core.csproj" />
  </ItemGroup>

</Project>
