<UserControl x:Class="AudioOptimizer.UI.Controls.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioOptimizer.UI.Controls"
             Width="1240" Height="700" Background="White">
    <!-- §25's Space/Enter bindings are built in code-behind, not here: InputBindings do not inherit the
         DataContext, so a {Binding MeasureCommand} in this block silently leaves Command null — measured: two
         KeyBindings with Command == null, i.e. keys that look wired and do nothing. -->
    <!-- Tabs, not columns: three milestones of views (project, measurement, analysis) cannot share one row without
         squashing each other, and a tab is the state a test can select explicitly. -->
    <TabControl x:Name="Tabs" Margin="8">
        <TabItem Header="Project">
        <Grid x:Name="ProjectPanel" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="RoomForge — project" FontSize="18" FontWeight="SemiBold" Foreground="#FF202020" />
                <TextBlock TextWrapping="Wrap" Foreground="#FF606060"
                           Text="Open a saved project to inspect or continue it. Nothing on this path touches an audio device." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectPathBox" Grid.Column="0" VerticalContentAlignment="Center" Padding="4,2"
                         Text="{Binding ProjectDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Name="LoadButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,3" Content="Load project"
                        Click="OnLoadClick" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FF202020" Text="{Binding StatusLine}" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#FF404040" Text="{Binding Message}" />
                <TextBlock x:Name="AffectedPathsText" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#FFB00020"
                           Text="{Binding AffectedPathSummary}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="#FF606060" Text="{Binding Schema, StringFormat=project {0}}" />
                <TextBlock TextWrapping="Wrap" Foreground="#FF606060" Text="{Binding Sweep, StringFormat=sweep {0}}" />
                <TextBlock TextWrapping="Wrap" Foreground="#FF606060" Text="{Binding Grid, StringFormat=grid {0}}" />
                <TextBlock TextWrapping="Wrap" Foreground="#FF606060" Text="{Binding ProjectId, StringFormat=id {0}}" />
            </StackPanel>

            <ListView x:Name="SlotList" Grid.Row="4" Margin="0,8,0,0" ItemsSource="{Binding Slots}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Measurement" Width="130" DisplayMemberBinding="{Binding MeasurementId}" />
                        <GridViewColumn Header="Mode" Width="42" DisplayMemberBinding="{Binding Mode}" />
                        <GridViewColumn Header="Position" Width="72" DisplayMemberBinding="{Binding PositionId}" />
                        <GridViewColumn Header="State" Width="54" DisplayMemberBinding="{Binding State}" />
                        <GridViewColumn Header="Signals" Width="90" DisplayMemberBinding="{Binding Signals}" />
                        <GridViewColumn Header="Peak" Width="68" DisplayMemberBinding="{Binding PeakMagnitude}" />
                        <GridViewColumn Header="Reasons" Width="130" DisplayMemberBinding="{Binding Reasons}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="5" Margin="0,8,0,0" Foreground="#FF606060" TextWrapping="Wrap"
                       Text="Loading a project reads session.json and does not open an audio device." />
        </Grid>
        </TabItem>

        <TabItem Header="Measure">
        <Grid x:Name="FlowPanel" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Measurement" FontSize="18" FontWeight="SemiBold" Foreground="#FF202020" />
                <TextBlock TextWrapping="Wrap" Foreground="#FF606060"
                           Text="Pick the capture and playback devices, start or resume, then measure each position with Space or Enter." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Text="Input" />
                <ComboBox x:Name="InputBox" Grid.Column="1" Padding="4,2" DisplayMemberPath="Name"
                          ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0" Text="Output" />
                <ComboBox x:Name="OutputBox" Grid.Column="3" Padding="4,2" DisplayMemberPath="Name"
                          ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" />
                <Button x:Name="RefreshDevicesButton" Grid.Column="4" Margin="8,0,0,0" Padding="10,3"
                        Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" />
            </Grid>

            <TextBlock x:Name="DeviceMessageText" Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF404040"
                       Text="{Binding DeviceMessage}" />

            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="Sweep (Hz, s, Hz)" Foreground="#FF606060" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="70" Padding="4,2" Text="{Binding StartHz, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="70" Margin="6,0,0,0" Padding="4,2" Text="{Binding EndHz, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="70" Margin="6,0,0,0" Padding="4,2" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="90" Margin="6,0,0,0" Padding="4,2" Text="{Binding SampleRate, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF606060"
                               Text="{Binding SweepText, StringFormat=sweep: {0}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <TextBlock Text="Grid (m, points per axis)" Foreground="#FF606060" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="60" Padding="4,2" Text="{Binding WidthMetres, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="60" Margin="6,0,0,0" Padding="4,2" Text="{Binding DepthMetres, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="60" Margin="6,0,0,0" Padding="4,2" Text="{Binding HeightMetres, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="46" Margin="12,0,0,0" Padding="4,2" Text="{Binding CountX, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="46" Margin="6,0,0,0" Padding="4,2" Text="{Binding CountY, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="46" Margin="6,0,0,0" Padding="4,2" Text="{Binding CountZ, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF606060"
                               Text="{Binding GridText, StringFormat=grid: {0}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="StartSessionButton" Padding="12,3" Content="Start / resume session"
                        Command="{Binding StartSessionCommand}" />
                <Button x:Name="MeasureButton" Margin="8,0,0,0" Padding="12,3" Content="Measure next point (Space)"
                        Command="{Binding MeasureCommand}" />
                <Button x:Name="SkipButton" Margin="8,0,0,0" Padding="12,3" Content="Skip" Command="{Binding SkipCommand}" />
                <Button x:Name="AbortButton" Margin="8,0,0,0" Padding="12,3" Content="Abort" Command="{Binding AbortCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,12,0,0">
                <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="#FF202020" Text="{Binding PromptText}" />
                <TextBlock x:Name="ProgressText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF404040"
                           Text="{Binding ProgressText}" />
                <TextBlock x:Name="FeedbackText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FFB00020"
                           Text="{Binding FeedbackText}" />
            </StackPanel>

            <TextBlock x:Name="FlowStatusText" Grid.Row="7" Margin="0,8,0,0" TextWrapping="Wrap" VerticalAlignment="Top"
                       Foreground="#FF202020" Text="{Binding Status}" />
        </Grid>
        </TabItem>

        <TabItem x:Name="AnalysisTab" Header="Analysis">
            <Grid x:Name="AnalysisPanel" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Analysis" FontSize="18" FontWeight="SemiBold" Foreground="#FF202020" />
                    <TextBlock TextWrapping="Wrap" Foreground="#FF606060"
                               Text="Curves are built from the measured points. Every dB number is stated against the reference on the plot — no level is claimed as absolute." />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Configuration" />
                    <ComboBox x:Name="ModeBox" Width="90" Padding="4,2" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />
                    <CheckBox x:Name="AllPositionsBox" Margin="16,0,0,0" VerticalAlignment="Center" Content="All measured positions"
                              IsChecked="{Binding ShowAllPositions}" />
                    <CheckBox x:Name="InterpolatedBox" Margin="16,0,0,0" VerticalAlignment="Center" Content="Interpolate"
                              IsChecked="{Binding Interpolated}" />
                    <TextBlock x:Name="LevelLabelText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF202020"
                               Text="{Binding LevelAxisLabel}" />
                </StackPanel>

                <TextBlock x:Name="AnalysisMessageText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF404040"
                           Text="{Binding Message}" />

                <UniformGrid Grid.Row="3" Margin="0,6,0,0" Columns="2" Rows="2">
                    <controls:CurveChart x:Name="LevelsChart" />
                    <controls:CurveChart x:Name="StdDevChart" />
                    <controls:CurveChart x:Name="RangeChart" />
                    <controls:CurveChart x:Name="OverlayChart" />
                </UniformGrid>
            </Grid>
        </TabItem>

        <TabItem x:Name="HeatmapTab" Header="Heatmaps">
            <Grid x:Name="HeatmapPanel" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Heatmaps" FontSize="18" FontWeight="SemiBold" Foreground="#FF202020" />
                    <TextBlock TextWrapping="Wrap" Foreground="#FF606060"
                               Text="One plane per analysed height, all drawn against the same colour scale, so a brighter colour always means a louder level." />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Frequency" />
                    <ComboBox x:Name="FrequencyBox" Width="100" Padding="4,2" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding RequestedHz}" />
                    <CheckBox x:Name="HeatmapInterpolatedBox" Margin="16,0,0,0" VerticalAlignment="Center" Content="Interpolate"
                              IsChecked="{Binding Interpolated}" />
                    <TextBlock x:Name="FrequencyText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF202020" Text="{Binding FrequencyText}" />
                </StackPanel>

                <TextBlock x:Name="HeatmapMessageText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF404040"
                           Text="{Binding Message}" />

                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                    <WrapPanel x:Name="PlaneHost" Orientation="Horizontal" />
                    <ContentControl x:Name="PositionMapHost" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem x:Name="OptimizeTab" Header="Optimize">
            <Grid x:Name="OptimizerPanel" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Dual-sub optimizer" FontSize="18" FontWeight="SemiBold" Foreground="#FF202020" />
                    <TextBlock TextWrapping="Wrap" Foreground="#FF606060"
                               Text="Weights change the preference among legal settings. The max-boost limit is offered as 0, 3 or 6 dB only, and the search reports the limit it was given next to the boost it achieved." />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center" Text="Spread" />
                    <TextBox x:Name="WeightSpreadBox" Width="52" Margin="6,0,14,0" Text="{Binding WeightMeanStdDev, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="P90−P10" />
                    <TextBox x:Name="WeightP90Box" Width="52" Margin="6,0,14,0" Text="{Binding WeightMeanP90P10, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="Peak" />
                    <TextBox x:Name="WeightPeakBox" Width="52" Margin="6,0,14,0" Text="{Binding WeightPeakPenalty, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="Null" />
                    <TextBox x:Name="WeightNullBox" Width="52" Margin="6,0,14,0" Text="{Binding WeightNullPenalty, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center" Text="Max boost (dB)" />
                    <ComboBox x:Name="MaxBoostBox" Width="80" Margin="6,0,16,0" Padding="4,2" SelectedItem="{Binding MaxBoostDb, Mode=TwoWay}" />
                    <Button x:Name="RunButton" Content="Run search" Width="110" Padding="8,3" IsEnabled="{Binding CanRun}" Command="{Binding RunCommand}" />
                    <Button x:Name="CheckModelButton" Content="Check model (§21)" Width="150" Margin="8,0,0,0" Padding="8,3" Command="{Binding ValidateModelCommand}" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="OptimizerStatusText" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#FF404040" />
                        <TextBlock x:Name="OptimizerVerdictText" Text="{Binding VerdictText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF202020" />
                        <TextBlock x:Name="OptimizerRecommendationText" Text="{Binding RecommendationText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF202020" />
                        <TextBlock x:Name="OptimizerBoostText" Text="{Binding BoostText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF202020" />
                        <TextBlock x:Name="OptimizerBindingText" Text="{Binding BindingText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF202020" />
                        <TextBlock Text="Per-frequency diagnosis" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="#FF202020" />
                        <ItemsControl x:Name="DiagnosisList" ItemsSource="{Binding DiagnosisLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FF404040" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="OptimizerModelText" Text="{Binding ModelVerdictText}" TextWrapping="Wrap" Foreground="#FF202020" />
                        <TextBlock Text="Structured causes (§21)" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="#FF202020" />
                        <ItemsControl x:Name="CauseList" ItemsSource="{Binding CauseLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FF404040" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- §24: the guide, appended LAST on purpose — the tabs before it keep their positions, because three
             render tests select them by index (Measure 1, Analysis 2, Optimize 4). -->
        <TabItem x:Name="WizardTab" Header="Wizard">
        <Grid x:Name="WizardPanel" Margin="8">
            <controls:WizardView x:Name="WizardContent" />
        </Grid>
        </TabItem>
    </TabControl>
</UserControl>
