<UserControl x:Class="AudioOptimizer.UI.Controls.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioOptimizer.UI.Controls"
             xmlns:loc="clr-namespace:AudioOptimizer.UI.Localization"
             Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AudioOptimizer.UI;component/Themes/Studio.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="ShowWhenTrue"/>
            <loc:ScenarioTitleConverter x:Key="ScenarioTitle"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- §25's Space/Enter bindings are built in code-behind, not here: InputBindings do not inherit the
         DataContext, so a {Binding MeasureCommand} in this block silently leaves Command null. -->
    <!-- Tab order is load-bearing: render tests select Measure, Analysis and Optimize by index. -->
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="RoomForge" FontSize="13" FontWeight="SemiBold" Foreground="#FF0F766E"/>
                <TextBlock Style="{StaticResource HelpText}" Margin="0,2,24,0"
                           Text="{Binding [App.Purpose], Source={x:Static loc:UiText.Current}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ChineseButton" Style="{StaticResource LangButton}" Margin="0,0,6,0"
                        Content="{Binding [Lang.Chinese], Source={x:Static loc:UiText.Current}}"
                        Click="OnChineseClick"/>
                <Button x:Name="EnglishButton" Style="{StaticResource LangButton}"
                        Content="{Binding [Lang.English], Source={x:Static loc:UiText.Current}}"
                        Click="OnEnglishClick"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1">
            <TabItem Header="{Binding [Nav.Project], Source={x:Static loc:UiText.Current}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ProjectPanel" Margin="4,12,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource PageTitle}"
                                       Text="{Binding [Project.Title], Source={x:Static loc:UiText.Current}}"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="{Binding [Project.Help], Source={x:Static loc:UiText.Current}}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProjectPathBox" Grid.Column="0"
                                     Text="{Binding ProjectDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BrowseProjectButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                        Content="{Binding [Project.Browse], Source={x:Static loc:UiText.Current}}"
                                        Click="OnBrowseProjectClick"/>
                                <Button x:Name="LoadButton" Margin="8,0,0,0"
                                        Content="{Binding [Project.Load], Source={x:Static loc:UiText.Current}}"
                                        Click="OnLoadClick"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FF1C1917" FontSize="14"
                                       Text="{Binding StatusLine}"/>
                            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF44403C"
                                       Text="{Binding Message}"/>
                            <TextBlock x:Name="AffectedPathsText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FFB91C1C"
                                       Text="{Binding AffectedPathSummary}"
                                       Visibility="{Binding ShowAffected, Converter={StaticResource ShowWhenTrue}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,10,0,0"
                                    Visibility="{Binding IsLoaded, Converter={StaticResource ShowWhenTrue}}">
                            <TextBlock TextWrapping="Wrap" Foreground="#FF78716C" Text="{Binding SchemaLine}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF78716C" Text="{Binding SweepLine}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF78716C" Text="{Binding GridLine}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF78716C" Text="{Binding IdLine}"/>
                        </StackPanel>

                        <ListView x:Name="SlotList" Grid.Row="4" Margin="0,12,0,0" MinHeight="180"
                                  ItemsSource="{Binding Slots}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="130" DisplayMemberBinding="{Binding MeasurementId}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding [Project.Col.Measurement], Source={x:Static loc:UiText.Current}}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding Mode}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding [Project.Col.Mode], Source={x:Static loc:UiText.Current}}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="90" DisplayMemberBinding="{Binding PositionId}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding [Project.Col.Position], Source={x:Static loc:UiText.Current}}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding DisplayState}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding [Project.Col.State], Source={x:Static loc:UiText.Current}}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="140" DisplayMemberBinding="{Binding Signals}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding [Project.Col.Signals], Source={x:Static loc:UiText.Current}}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="90" DisplayMemberBinding="{Binding PeakMagnitude}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding [Project.Col.Peak], Source={x:Static loc:UiText.Current}}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="160" DisplayMemberBinding="{Binding Reasons}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{Binding [Project.Col.Reasons], Source={x:Static loc:UiText.Current}}"/>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Grid.Row="5" Margin="0,10,0,0" Foreground="#FF78716C" TextWrapping="Wrap"
                                   Text="{Binding [Project.Foot], Source={x:Static loc:UiText.Current}}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding [Nav.Measure], Source={x:Static loc:UiText.Current}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="FlowPanel" Margin="4,12,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource PageTitle}"
                                       Text="{Binding [Measure.Title], Source={x:Static loc:UiText.Current}}"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="{Binding [Measure.Help], Source={x:Static loc:UiText.Current}}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="{Binding [Measure.Input], Source={x:Static loc:UiText.Current}}"/>
                                <ComboBox x:Name="InputBox" DisplayMemberPath="Name"
                                          ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="{Binding [Measure.Output], Source={x:Static loc:UiText.Current}}"/>
                                <ComboBox x:Name="OutputBox" DisplayMemberPath="Name"
                                          ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}"/>
                            </StackPanel>
                            <Button x:Name="RefreshDevicesButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Bottom"
                                    Content="{Binding [Measure.Refresh], Source={x:Static loc:UiText.Current}}"
                                    Command="{Binding RefreshDevicesCommand}"/>
                        </Grid>

                        <TextBlock x:Name="DeviceMessageText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="#FF44403C" Text="{Binding DeviceMessage}"/>

                        <StackPanel Grid.Row="3" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding [Measure.Sweep], Source={x:Static loc:UiText.Current}}"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.StartHz], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="88" Text="{Binding StartHz, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.EndHz], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="88" Text="{Binding EndHz, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Seconds], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="88" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Rate], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="100" Text="{Binding SampleRate, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Foreground="#FF78716C" Text="{Binding SweepLine}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding [Measure.Grid], Source={x:Static loc:UiText.Current}}"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Width], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="72" Text="{Binding WidthMetres, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Depth], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="72" Text="{Binding DepthMetres, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Height], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="72" Text="{Binding HeightMetres, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.CountX], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="72" Text="{Binding CountX, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.CountY], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="72" Text="{Binding CountY, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.CountZ], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox Width="72" Text="{Binding CountZ, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Foreground="#FF78716C" Text="{Binding GridLine}"/>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF57534E"
                                       Text="{Binding [Measure.Rounds], Source={x:Static loc:UiText.Current}}"/>
                        </StackPanel>

                        <Grid Grid.Row="5" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="{Binding [Measure.Folder], Source={x:Static loc:UiText.Current}}"/>
                                <TextBox x:Name="SaveFolderBox"
                                         Text="{Binding ProjectDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button x:Name="BrowseFolderButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Bottom"
                                    Content="{Binding [Measure.Browse], Source={x:Static loc:UiText.Current}}"
                                    Click="OnBrowseMeasureClick"/>
                        </Grid>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="StartSessionButton"
                                    Content="{Binding [Measure.Start], Source={x:Static loc:UiText.Current}}"
                                    Command="{Binding StartSessionCommand}"/>
                            <Button x:Name="MeasureButton" Margin="8,0,0,0"
                                    Content="{Binding [Measure.Next], Source={x:Static loc:UiText.Current}}"
                                    Command="{Binding MeasureCommand}"/>
                            <Button x:Name="SkipButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Content="{Binding [Measure.Skip], Source={x:Static loc:UiText.Current}}"
                                    Command="{Binding SkipCommand}"/>
                            <Button x:Name="AbortButton" Margin="8,0,0,0" Style="{StaticResource DangerButton}"
                                    Content="{Binding [Measure.Abort], Source={x:Static loc:UiText.Current}}"
                                    Command="{Binding AbortCommand}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Margin="0,16,0,0">
                            <TextBlock x:Name="PromptText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="#FF1C1917" Text="{Binding PromptText}"/>
                            <TextBlock x:Name="ProgressText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FF44403C"
                                       Text="{Binding ProgressText}"/>
                            <TextBlock x:Name="FeedbackText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FFB91C1C"
                                       Text="{Binding FeedbackText}"/>
                        </StackPanel>

                        <TextBlock x:Name="FlowStatusText" Grid.Row="8" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="#FF1C1917" Text="{Binding Status}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AnalysisTab" Header="{Binding [Nav.Analysis], Source={x:Static loc:UiText.Current}}">
                <Grid x:Name="AnalysisPanel" Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource PageTitle}"
                                   Text="{Binding [Analysis.Title], Source={x:Static loc:UiText.Current}}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="{Binding [Analysis.Help], Source={x:Static loc:UiText.Current}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{Binding [Analysis.Mode], Source={x:Static loc:UiText.Current}}"/>
                        <ComboBox x:Name="ModeBox" Width="110" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
                        <CheckBox x:Name="AllPositionsBox" Margin="16,0,0,0"
                                  Content="{Binding [Analysis.All], Source={x:Static loc:UiText.Current}}"
                                  IsChecked="{Binding ShowAllPositions}"/>
                        <CheckBox x:Name="InterpolatedBox" Margin="16,0,0,0"
                                  Content="{Binding [Analysis.Interp], Source={x:Static loc:UiText.Current}}"
                                  IsChecked="{Binding Interpolated}"/>
                        <TextBlock x:Name="LevelLabelText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF1C1917"
                                   Text="{Binding LevelAxisLabel}"/>
                    </StackPanel>

                    <TextBlock x:Name="AnalysisMessageText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="#FF44403C" Text="{Binding Message}"/>

                    <UniformGrid Grid.Row="3" Margin="0,8,0,0" Columns="2" Rows="2">
                        <controls:CurveChart x:Name="LevelsChart"/>
                        <controls:CurveChart x:Name="StdDevChart"/>
                        <controls:CurveChart x:Name="RangeChart"/>
                        <controls:CurveChart x:Name="OverlayChart"/>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="HeatmapTab" Header="{Binding [Nav.Heatmaps], Source={x:Static loc:UiText.Current}}">
                <Grid x:Name="HeatmapPanel" Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource PageTitle}"
                                   Text="{Binding [Heat.Title], Source={x:Static loc:UiText.Current}}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="{Binding [Heat.Help], Source={x:Static loc:UiText.Current}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{Binding [Heat.Frequency], Source={x:Static loc:UiText.Current}}"/>
                        <ComboBox x:Name="FrequencyBox" Width="110" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding RequestedHz}"/>
                        <CheckBox x:Name="HeatmapInterpolatedBox" Margin="16,0,0,0"
                                  Content="{Binding [Analysis.Interp], Source={x:Static loc:UiText.Current}}"
                                  IsChecked="{Binding Interpolated}"/>
                        <TextBlock x:Name="FrequencyText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF1C1917"
                                   Text="{Binding FrequencyText}"/>
                    </StackPanel>

                    <TextBlock x:Name="HeatmapMessageText" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="#FF44403C" Text="{Binding Message}"/>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">
                            <WrapPanel x:Name="PlaneHost" Orientation="Horizontal"/>
                            <ContentControl x:Name="PositionMapHost" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="OptimizeTab" Header="{Binding [Nav.Optimize], Source={x:Static loc:UiText.Current}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="OptimizerPanel" Margin="4,12,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource PageTitle}"
                                       Text="{Binding [Opt.Title], Source={x:Static loc:UiText.Current}}"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="{Binding [Opt.Help], Source={x:Static loc:UiText.Current}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Opt.Spread], Source={x:Static loc:UiText.Current}}"/>
                                <TextBox x:Name="WeightSpreadBox" Width="64" Text="{Binding WeightMeanStdDev, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Opt.P90], Source={x:Static loc:UiText.Current}}"/>
                                <TextBox x:Name="WeightP90Box" Width="64" Text="{Binding WeightMeanP90P10, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Opt.Peak], Source={x:Static loc:UiText.Current}}"/>
                                <TextBox x:Name="WeightPeakBox" Width="64" Text="{Binding WeightPeakPenalty, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Opt.Null], Source={x:Static loc:UiText.Current}}"/>
                                <TextBox x:Name="WeightNullBox" Width="64" Text="{Binding WeightNullPenalty, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock VerticalAlignment="Center" Text="{Binding [Opt.Boost], Source={x:Static loc:UiText.Current}}"/>
                            <ComboBox x:Name="MaxBoostBox" Width="80" Margin="8,0,16,0" SelectedItem="{Binding MaxBoostDb, Mode=TwoWay}"/>
                            <Button x:Name="RunButton" MinWidth="120"
                                    Content="{Binding [Opt.Run], Source={x:Static loc:UiText.Current}}"
                                    IsEnabled="{Binding CanRun}" Command="{Binding RunCommand}"/>
                            <Button x:Name="CheckModelButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Content="{Binding [Opt.Check], Source={x:Static loc:UiText.Current}}"
                                    Command="{Binding ValidateModelCommand}"/>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock x:Name="OptimizerStatusText" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#FF44403C"/>
                                <TextBlock x:Name="OptimizerVerdictText" Text="{Binding VerdictText}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF1C1917"/>
                                <TextBlock x:Name="OptimizerRecommendationText" Text="{Binding RecommendationText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF1C1917"/>
                                <TextBlock x:Name="OptimizerBoostText" Text="{Binding BoostText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF1C1917"/>
                                <TextBlock x:Name="OptimizerBindingText" Text="{Binding BindingText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF1C1917"/>
                                <TextBlock FontWeight="SemiBold" Margin="0,12,0,4" Foreground="#FF1C1917"
                                           Text="{Binding [Opt.Diagnosis], Source={x:Static loc:UiText.Current}}"/>
                                <ItemsControl x:Name="DiagnosisList" ItemsSource="{Binding DiagnosisLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FF44403C" Margin="0,2,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="OptimizerModelText" Text="{Binding ModelVerdictText}" TextWrapping="Wrap" Foreground="#FF1C1917"/>
                                <TextBlock FontWeight="SemiBold" Margin="0,12,0,4" Foreground="#FF1C1917"
                                           Text="{Binding [Opt.Causes], Source={x:Static loc:UiText.Current}}"/>
                                <ItemsControl x:Name="CauseList" ItemsSource="{Binding CauseLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FF44403C" Margin="0,2,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Appended last so earlier tabs keep their indexes. -->
            <TabItem x:Name="WizardTab" Header="{Binding [Nav.Wizard], Source={x:Static loc:UiText.Current}}">
                <Grid x:Name="WizardPanel" Margin="8">
                    <controls:WizardView x:Name="WizardContent"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="SimulationTab" Header="{Binding [Nav.Simulation], Source={x:Static loc:UiText.Current}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="SimulationPanel" Margin="4,12,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource PageTitle}"
                                       Text="{Binding [Sim.Title], Source={x:Static loc:UiText.Current}}"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="{Binding [Sim.Help], Source={x:Static loc:UiText.Current}}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Text="{Binding [Sim.Scenario], Source={x:Static loc:UiText.Current}}"/>
                            <ComboBox x:Name="ScenarioBox" Grid.Column="1"
                                      ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Scenario}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ScenarioTitle}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="GenerateButton" Grid.Column="2" Margin="8,0,0,0"
                                    Content="{Binding [Sim.Generate], Source={x:Static loc:UiText.Current}}"
                                    Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding [Sim.Room], Source={x:Static loc:UiText.Current}}"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sim.Length], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="RoomLengthBox" Width="72" Text="{Binding RoomLength, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sim.Width], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="RoomWidthBox" Width="72" Text="{Binding RoomWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sim.Height], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="RoomHeightBox" Width="72" Text="{Binding RoomHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <TextBlock Margin="16,18,0,0" VerticalAlignment="Center" Foreground="#FF78716C"
                                           Text="{Binding [Sim.Grid], Source={x:Static loc:UiText.Current}}"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Width], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="RegionWidthBox" Width="72" Text="{Binding RegionWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Depth], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="RegionDepthBox" Width="72" Text="{Binding RegionDepth, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Height], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="RegionHeightBox" Width="72" Text="{Binding RegionHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding [Sim.Subs], Source={x:Static loc:UiText.Current}}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,18,8,0" Foreground="#FF78716C" Text="{Binding [Sim.SubA], Source={x:Static loc:UiText.Current}}"/>
                                <TextBox x:Name="SubAXBox" Width="72" Text="{Binding SubAX, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="SubAYBox" Width="72" Margin="8,0,0,0" Text="{Binding SubAY, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="SubAZBox" Width="72" Margin="8,0,0,0" Text="{Binding SubAZ, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="16,18,8,0" Foreground="#FF78716C" Text="{Binding [Sim.SubB], Source={x:Static loc:UiText.Current}}"/>
                                <TextBox x:Name="SubBXBox" Width="72" Text="{Binding SubBX, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="SubBYBox" Width="72" Margin="8,0,0,0" Text="{Binding SubBY, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="SubBZBox" Width="72" Margin="8,0,0,0" Text="{Binding SubBZ, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding [Sim.Tone], Source={x:Static loc:UiText.Current}}"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.StartHz], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="StartHzBox" Width="72" Text="{Binding StartHz, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.EndHz], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="EndHzBox" Width="72" Text="{Binding EndHz, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Measure.Seconds], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="DurationBox" Width="72" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sim.Noise], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="NoiseBox" Width="90" Text="{Binding NoiseLevel, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding [Sim.PlaneHz], Source={x:Static loc:UiText.Current}}"/>
                                    <TextBox x:Name="PlaneFrequencyBox" Width="72" Text="{Binding HeatmapFrequencyHz, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Margin="0,14,0,0">
                            <TextBlock x:Name="SimulationStatusText" TextWrapping="Wrap" Foreground="#FF1C1917" Text="{Binding Status}"/>
                            <TextBlock x:Name="SimulationPipelineText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF44403C" Text="{Binding PipelineText}"/>
                            <TextBlock x:Name="SimulationStatsText" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FF1C1917" Text="{Binding StatsText}"/>
                            <TextBlock x:Name="SimulationOptimizerText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF1C1917" Text="{Binding OptimizerText}"/>
                            <TextBlock x:Name="SimulationGroundTruthText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF44403C" Text="{Binding GroundTruthText}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Margin="0,8,0,0">
                            <StackPanel x:Name="SimulationChartHost" Orientation="Horizontal"/>
                            <WrapPanel x:Name="SimulationPlaneHost" Orientation="Horizontal" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
